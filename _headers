# Cloudflare Pages headers
# https://developers.cloudflare.com/pages/configuration/headers/

# ─────────────────────────────────────────────────────────────────────────────
# Security headers — applied to all pages
# ─────────────────────────────────────────────────────────────────────────────
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# ─────────────────────────────────────────────────────────────────────────────
# Long-term caching for immutable assets (fonts/images/videos)
# These are content-addressed (hashed filenames) or rarely change. Safe to mark
# `immutable` because the URL changes when the content changes.
# ─────────────────────────────────────────────────────────────────────────────
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/videos/*
  Cache-Control: public, max-age=31536000, immutable

# ─────────────────────────────────────────────────────────────────────────────
# CSS and JS — must revalidate, NOT immutable
#
# Why not `immutable`: these files use unversioned paths (e.g. `/js/calendly-
# init.v2.js`, `/css/main.css`). When we ship a content change, the URL stays
# the same, but `immutable` tells the Cloudflare CDN to skip revalidation
# entirely until max-age expires. With `max-age=31536000, immutable`, an edit
# can take up to a year to propagate to clients with a cached copy.
#
# `must-revalidate` + a sensible max-age means the CDN will conditionally
# fetch (304 Not Modified) the asset against origin on each cache lookup,
# picking up new content on the next deploy automatically.
#
# Trade-off vs. immutable: more conditional GETs to origin. Pages handles
# these efficiently (304 responses are cheap), and the protection against
# stale-asset incidents is worth far more than the extra requests.
# ─────────────────────────────────────────────────────────────────────────────
/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# ─────────────────────────────────────────────────────────────────────────────
# Short cache for HTML — allows fast content updates
# ─────────────────────────────────────────────────────────────────────────────
/*.html
  Cache-Control: public, max-age=300, must-revalidate

/
  Cache-Control: public, max-age=300, must-revalidate

# ─────────────────────────────────────────────────────────────────────────────
# Sitemap and robots — moderate cache
# ─────────────────────────────────────────────────────────────────────────────
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
